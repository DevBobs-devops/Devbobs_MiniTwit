FROM mcr.microsoft.com/dotnet/sdk:8.0

RUN apt-get update && apt-get install -y \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN dotnet restore test/PlaywrightTests/PlaywrightTests.csproj
RUN dotnet build test/PlaywrightTests/PlaywrightTests.csproj --no-restore

RUN pwsh test/PlaywrightTests/bin/Debug/net8.0/playwright.ps1 install --with-deps chromium

CMD ["dotnet", "test", "test/PlaywrightTests/PlaywrightTests.csproj", \
     "--no-build", \
     "--logger", "trx;LogFileName=e2e-results.trx"]
